{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "plot-twist",
  "version": "0.1.0",
  "identifier": "io.github.kdaquila.plottwist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../target/ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "plot-twist",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "license": "GPL-3.0-or-later",
    "category": "Productivity",
    "shortDescription": "Modern data analysis GUI for researchers"
  }
}
